# ── Access ──────────────────────────────────────────────
# Basic-auth password for the dashboard (required in production).
DASHBOARD_PASSWORD=
DASHBOARD_USER=wrs
# Secret Vercel Cron sends to /api/cron/snapshot.
CRON_SECRET=

# ── Baseline (optional, overrides data/baseline.json) ───
# First day of the earliest reliable period before DXW, YYYY-MM-DD.
BASELINE_START=

# ── Google service account: GA4 + Search Console ────────
# Full JSON key, raw or base64. Add its client_email as Viewer in GA4
# and as a user in Search Console.
GOOGLE_SERVICE_ACCOUNT_JSON=
GA4_PROPERTY_ID=
# e.g. sc-domain:weatherrecoverysolutions.com or https://weatherrecoverysolutions.com/
GSC_SITE_URL=

# ── Google Business Profile (needs Google API approval) ─
GBP_LOCATION_ID=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GBP_REFRESH_TOKEN=

# ── Reviews: same values the WRS site already uses ──────
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACES_ID=

# ── JobNimbus: same key the WRS site form uses ──────────
JOBNIMBUS_API_KEY=

# ── Technical ───────────────────────────────────────────
PAGESPEED_API_KEY=
# GTM container id, e.g. GTM-XXXXXXX (same as the site's NEXT_PUBLIC_GTM_ID)
GTM_ID=
WRS_SITE_URL=https://weatherrecoverysolutions.com

# ── Daily snapshot storage (Vercel Blob) ────────────────
BLOB_READ_WRITE_TOKEN=

# ── Layout review only: fills the page with made-up numbers ──
# DASHBOARD_SAMPLE_DATA=1
